{
  "name": "meros-kassa",
  "version": "1.0.0",
  "description": "MVP web cash register",
  "author": "MerosKassa Team",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "desktop": "electron .",
    "desktop:dev": "electron . --dev",
    "build:win": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "rebuild:electron": "electron-builder install-app-deps",
    "pack": "electron-packager . MerosKassa --platform=win32 --arch=x64 --out=dist --ignore=node_modules/electron-packager/**/*"
  },
  "dependencies": {
    "express": "^4.19.2",
    "iconv-lite": "^0.6.3",
    "multer": "^2.0.2",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "kz.meroskassa.desktop",
    "productName": "MerosKassa",
    "asar": true,
    "asarUnpack": [
      "node_modules/sqlite3/**/*"
    ],
    "files": [
      "electron/**/*",
      "public/**/*",
      "routes/**/*",
      "lib/**/*",
      "server.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "!**"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  }
}